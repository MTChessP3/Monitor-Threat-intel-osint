generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ReportTemplate {
  id        String   @id @default(cuid())
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports   Report[]
}

model NewsSource {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   @default("web")
  category  String   @default("seguridad")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id              String          @id @default(cuid())
  title           String
  date            DateTime        @default(now())
  summary         String
  threatLevel     String          @default("bajo")
  content         String
  templateId      String?
  template        ReportTemplate? @relation(fields: [templateId], references: [id])
  sourcesUsed     String          @default("[]")
  generationMode  String          @default("automatic")
  abuseTypes      String          @default("[]")
  severity        String          @default("medio")
  tlpLevel        String          @default("GREEN")
  inputUrls       String          @default("[]")
  inputText       String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("analyst")
  mfaEnabled Boolean  @default(false)
  mfaSecret  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Executive {
  id                  String   @id @default(cuid())
  identificationNum   String   @unique
  fullName            String
  email               String?
  phone               String?
  position            String?
  organization        String?
  riskLevel           String   @default("bajo")
  notes               String?
  lastMetasearch      DateTime?
  lastMetasearchResults String?  @default("[]")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  familyMembers       FamilyMember[]
}

model FamilyMember {
  id                  String   @id @default(cuid())
  executiveId         String   @unique
  fullName            String
  relationship        String   // father, mother, son, daughter, spouse, etc
  identificationNum   String?
  email               String?
  phone               String?
  riskLevel           String   @default("bajo")
  notes               String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relation to Executive
  executive           Executive @relation(fields: [executiveId], references: [id])
}

model TakeDownBatch {
  id            String   @id @default(cuid())
  name          String
  status        String   @default("pending")
  totalUrls     Int      @default(0)
  processedUrls Int      @default(0)
  successfulUrls Int     @default(0)
  failedUrls    Int      @default(0)
  userId        String
  notes         String?
  fingerprint   String?
  fileHash      String?
  reportHash    String?
  services      String?
  virustotalResults String? @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?
  reports       TakeDownReport[]
  serviceResults ServiceResult[]
}

model TakeDownReport {
  id              String   @id @default(cuid())
  batchId         String
  url             String
  originalUrl     String?
  status          String   @default("pending")
  fingerprint     String?
  virustotalClassification String?
  virustotalMaliciousEngines Int @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  batch           TakeDownBatch @relation(fields: [batchId], references: [id])
  serviceResults  ServiceResult[]
}

model ServiceResult {
  id              String   @id @default(cuid())
  batchId         String
  reportId        String?
  service         String
  serviceName     String
  url             String
  status          String
  message         String?
  referenceId     String?
  requestPayload  String?
  responsePayload String?
  errorDetails    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  batch           TakeDownBatch @relation(fields: [batchId], references: [id])
}

model EmailLog {
  id            String   @id @default(cuid())
  type          String
  recipient     String
  batchId       String?
  referenceId   String?
  status        String
  payload       String?
  errorDetails  String?
  createdAt     DateTime @default(now())
}

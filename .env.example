# ============================================
# VIP_Protection Report - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database (Local: SQLite) ---
DATABASE_URL=file:./dev.db

# --- Database (Vercel: PostgreSQL) ---
# For Vercel deployment, set these in the Vercel Dashboard
# The build script (scripts/vercel-build.sh) will auto-switch to PostgreSQL
# POSTGRES_PRISMA_URL=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...

# --- Z AI SDK (required for AI analysis) ---
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

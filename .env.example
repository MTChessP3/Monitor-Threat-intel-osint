# ============================================
# VIP_Protection Report - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database (Local: SQLite) ---
DATABASE_URL=file:./dev.db

# --- Database (Vercel/Turso: libSQL persistente) ---
# Sin estas variables, en Vercel se usa SQLite en /tmp (EFIMERO:
# los datos se pierden entre requests/instancias y en cada redeploy).
# Crear la base en https://turso.tech y configurar las variables en Vercel.
# TURSO_DATABASE_URL=libsql://vip-intelligence-xxx.turso.io
# TURSO_AUTH_TOKEN=

# --- Z AI SDK (required for AI analysis) ---
# Necesarias en Vercel para chat + web_search. Si la busqueda web
# devuelve 0 resultados, verifica que la funcion 'web_search' este
# habilitada en la plataforma Z AI ademas del chat.
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

# ============================================
# VIP_Protection Report - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database (Vercel Postgres / Neon) ---
# Get these from Vercel Dashboard > Storage > Postgres > .env.local tab
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Z AI SDK (required for AI analysis) ---
# Get these from your Z AI configuration
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

# ============================================
# VIP_Protection Report - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database (Local: SQLite) ---
DATABASE_URL=file:./dev.db

# --- Database (Vercel/Turso: libSQL persistente) ---
# Sin estas variables, en Vercel se usa SQLite en /tmp (EFIMERO:
# los datos se pierden entre requests/instancias y en cada redeploy).
# Crear la base en https://turso.tech y configurar las variables en Vercel.
# TURSO_DATABASE_URL=libsql://vip-intelligence-xxx.turso.io
# TURSO_AUTH_TOKEN=

# --- Z.AI Public Platform API (AI analysis / report generation) ---
# La BUSQUEDA WEB es gratis (DuckDuckGo, sin API key). Z.AI solo se usa para
# el chat/analisis con el modelo gratuito glm-4.5-flash.
# Crear una API key en https://z.ai/manage-apikey/apikey-list
# NOTA: la API interna `internal-api.z.ai` (red privada de Alibaba Cloud) NO
# es alcanzable desde Vercel; usar siempre la API publica.
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=
# Opcional: modelo para chat/analisis (default: glm-4.5-flash - gratis)
# ZAI_MODEL=glm-4.5-flash
=======
# ===== NEXUS INTEL / MONITOR-THREAT Configuration =====
# Copy this file to .env and fill in your keys.
# Local development works without any keys (AI + KV fall back to demo/memory mode).

# ---- AI (OpenAI-compatible, defaults to Groq) ----
# Get a free key at https://console.groq.com/keys
AI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# ---- Persistence (Vercel KV / Upstash Redis) ----
# Create a KV store in the Vercel dashboard; the REST URL and token are auto-injected.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional intelligence sources ----
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
